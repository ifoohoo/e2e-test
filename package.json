{
  "name": "e2e-test",
  "version": "0.1.0",
  "description": "E2E 测试专业技能族 — 框架中立、experimental 的 E2E 规格技能族",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "packageManager": "pnpm@10.17.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build-adapters.mjs",
    "build:check": "node scripts/build-adapters.mjs --check",
    "check-skills": "node scripts/check-skills.mjs",
    "gate-status": "node scripts/gate-status.mjs",
    "public:release:verify": "node scripts/verify-public-release.mjs"
  },
  "keywords": [
    "e2e",
    "testing",
    "skill-family",
    "artifact-graph",
    "agent-method"
  ],
  "files": [
    "skills/",
    "family/",
    "references/",
    "scripts/",
    "adapters/",
    "INSTALL.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ]
}
