{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.e2e-test.dev/behavior-qualification-scenario/v1",
  "title": "Behavior Qualification Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "host", "status", "identity", "checks", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "host": { "enum": ["codex", "claude-code"] },
    "status": { "enum": ["PASS", "FAIL"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyApiRevision", "contractRevision", "implementationId", "implementationVersion", "qualificationInputTarballDigest", "qualificationSubjectDigest", "bundleDigest", "deterministicAttestation", "fixtureDigests"],
      "properties": {
        "familyApiRevision": { "$ref": "#/$defs/digest" },
        "contractRevision": { "$ref": "#/$defs/digest" },
        "implementationId": { "type": "string", "minLength": 1 },
        "implementationVersion": { "type": "string", "minLength": 1 },
        "qualificationInputTarballDigest": { "$ref": "#/$defs/digest" },
        "qualificationSubjectDigest": { "$ref": "#/$defs/digest" },
        "bundleDigest": { "$ref": "#/$defs/digest" },
        "deterministicAttestation": { "$ref": "#/$defs/digest" },
        "fixtureDigests": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "allOf": [
            { "contains": { "properties": { "name": { "const": "artifact.json" } }, "required": ["name"] } },
            { "contains": { "properties": { "name": { "const": "candidate-assessment.json" } }, "required": ["name"] } },
            { "contains": { "properties": { "name": { "const": "inspection.json" } }, "required": ["name"] } },
            { "contains": { "properties": { "name": { "const": "matrix.json" } }, "required": ["name"] } }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "digest"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "$ref": "https://schemas.e2e-test.dev/behavior-qualification-result/v1#/$defs/trial" }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
