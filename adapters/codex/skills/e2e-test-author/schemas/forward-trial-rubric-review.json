{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "e2e-test/forward-trial-rubric-review/v1",
  "title": "Forward Trial Rubric Reviewer Output",
  "description": "独立 reviewer 的语义输出。身份、盲评访问证据与摘要由控制平面补齐。",
  "type": "object",
  "required": ["dimensions", "overall", "summary"],
  "additionalProperties": false,
  "properties": {
    "dimensions": {
      "type": "object",
      "required": ["candidateSelection", "businessBoundary", "oracleQuality", "isolationCleanup", "exceptionRecovery", "traceability", "matrixFidelity", "executability"],
      "additionalProperties": false,
      "properties": {
        "candidateSelection": { "$ref": "#/definitions/dimensionScore" },
        "businessBoundary": { "$ref": "#/definitions/dimensionScore" },
        "oracleQuality": { "$ref": "#/definitions/dimensionScore" },
        "isolationCleanup": { "$ref": "#/definitions/dimensionScore" },
        "exceptionRecovery": { "$ref": "#/definitions/dimensionScore" },
        "traceability": { "$ref": "#/definitions/dimensionScore" },
        "matrixFidelity": { "$ref": "#/definitions/dimensionScore" },
        "executability": { "$ref": "#/definitions/dimensionScore" }
      }
    },
    "overall": { "type": "string", "enum": ["PASS", "PARTIAL", "FAIL"] },
    "summary": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "dimensionScore": {
      "type": "object",
      "required": ["score", "rationale", "evidenceRefs"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "string", "enum": ["pass", "partial", "fail"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
