{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "e2e-test/binding-manifest/v1",
  "title": "BindingManifest",
  "type": "object",
  "required": [
    "bindingId",
    "planDigest",
    "generatedTestDigests",
    "bindings",
    "claimScope",
    "bindingDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "bindingId": { "type": "string", "minLength": 1 },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generatedTestDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "file",
          "title",
          "fixtureDigest",
          "assertionDigest"
        ],
        "additionalProperties": false,
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "fixtureDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "assertionDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "claimScope": { "enum": ["IMPLEMENTED", "READY_TO_RUN"] },
    "bindingDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
