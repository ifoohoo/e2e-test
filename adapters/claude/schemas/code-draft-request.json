{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "e2e-test/code-draft-request/v1",
  "title": "CodeDraftRequest",
  "type": "object",
  "required": ["contract", "planDigest", "cases", "policy", "requestDigest"],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "e2e-test/code-draft-request/v1"
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "file",
          "title",
          "fixtureDigest",
          "assertionDigest",
          "businessOracleRef",
          "actor",
          "goal",
          "task",
          "steps",
          "oracle",
          "fixture"
        ],
        "additionalProperties": false,
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "fixtureDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "assertionDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "businessOracleRef": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "task": { "type": "string", "minLength": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "oracle": {
            "type": "object",
            "required": ["observable", "criterion", "negativeCheck", "timeoutMs"],
            "additionalProperties": false,
            "properties": {
              "observable": { "type": "string", "minLength": 1 },
              "criterion": { "type": "string", "minLength": 1 },
              "negativeCheck": { "type": "string", "minLength": 1 },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120000
              }
            }
          },
          "fixture": {
            "type": "object",
            "required": [
              "testData",
              "identities",
              "isolation",
              "setup",
              "cleanup",
              "failureCleanup"
            ],
            "additionalProperties": false,
            "properties": {
              "testData": {
                "type": "array",
                "items": { "type": "string" }
              },
              "identities": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "isolation": { "type": "string", "minLength": 1 },
              "setup": {
                "type": "array",
                "items": { "type": "string" }
              },
              "cleanup": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "failureCleanup": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "locatorApproaches",
        "waitKinds",
        "maxRetry",
        "forbiddenPatterns"
      ],
      "additionalProperties": false,
      "properties": {
        "locatorApproaches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "enum": ["role", "test-id"] }
        },
        "waitKinds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "enum": ["poll", "event", "state"] }
        },
        "maxRetry": { "const": 0 },
        "forbiddenPatterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
