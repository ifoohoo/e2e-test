    }
  ],
  "test_cases": [
    {
      "case_id": "TC-001",
      "goal": "完成商品购买并获得订单确认",
      "preconditions": [
        "初始化测试商品",
        "预置测试账户余额"
      ],
      "actions": [
        {
          "step": 1,
          "action": "用户浏览商品列表"
        },
        {
          "step": 2,
          "action": "用户添加商品到购物车"
        },
        {
          "step": 3,
          "action": "用户进入结算页面"
        },
        {
          "step": 4,
          "action": "用户选择支付方式并确认支付"
        },
        {
          "step": 5,
          "action": "支付网关返回成功"
        },
        {
          "step": 6,
          "action": "订单状态更新为已支付"
        },
        {
          "step": 7,
          "action": "用户看到订单确认页面"
        }
      ],
      "oracles": [
        {
          "observable": "订单确认页面显示订单号和支付成功状态",
          "criterion": "订单状态为 paid 且包含正确金额",
          "timeout_ms": 10000
        }
      ],
      "cleanup": [
        "删除测试订单",
        "恢复库存",
        "失败清理：强制取消未完成订单",
        "失败清理：恢复库存",
        "失败清理：清理测试账户",
        "补偿：退款并释放库存"
      ],
      "priority": "critical",
      "trace_targets": [
        "CAND-001",
        "feature:F-001",
        "scenario:S-001",
        "AC-001",
        "AC-002"
      ],
      "path_class": "happy"
    },
    {
      "case_id": "TC-002",
      "goal": "支付失败后看到明确结果且数据回滚",
      "preconditions": [
        "初始化测试商品",
        "配置支付网关返回失败"
      ],
      "actions": [
        {
          "step": 1,
          "action": "用户发起支付"
        },
        {
          "step": 2,
          "action": "支付网关返回失败"
        },
        {
          "step": 3,
          "action": "订单服务回滚订单状态"
        },
        {
          "step": 4,
          "action": "库存服务恢复库存"
        },
        {
          "step": 5,
          "action": "通知服务发送支付失败通知"
        }
      ],
      "oracles": [
        {
          "observable": "订单确认页面显示订单号和支付成功状态",
          "criterion": "订单状态为 paid 且包含正确金额",
          "timeout_ms": 10000
        }
      ],
      "cleanup": [
        "确认订单已取消",
        "确认库存已恢复",
        "失败清理：强制取消订单",
        "失败清理：强制恢复库存",
        "失败清理：清理通知队列",
        "补偿：撤销支付授权",
        "补偿：恢复库存"
      ],
      "priority": "high",
      "trace_targets": [
        "CAND-002",
        "feature:F-001",
        "scenario:S-002",
        "AC-003"
      ],
      "path_class": "error"
    }
  ],
  "evidence_contract": {
    "required_artifacts": [
      "runs/e2e-test/TC-001/trace.zip",
      "trace.zip",
      "order-confirmation.png",
      "runs/e2e-test/TC-002/trace.zip",
      "rollback-log.json"
    ],
    "runner_binding": "playwright",
    "proof_requirements": [
      "TC-001:trace 中包含订单确认页面截图且订单状态为 paid",
      "TC-002:trace 中包含取消订单截图和通知记录"
    ]
  }
}
