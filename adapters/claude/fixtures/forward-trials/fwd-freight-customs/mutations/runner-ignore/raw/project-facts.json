{
  "systems": [
    "document-service",
    "declaration-service",
    "customs-gateway",
    "warehouse-service",
    "audit-log"
  ],
  "runnerInventory": {
    "cucumber": {
      "active": true,
      "include": [
        "features/customs/**/*.feature"
      ],
      "ignored": true
    }
  },
  "dataPolicy": {
    "identity": "unique-declaration-batch",
    "isolation": "tenant-and-batch partition"
  },
  "evidence": {
    "required": [
      "gateway-receipt",
      "audit-log"
    ],
    "freshness": "current"
  }
}
