{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "e2e-test/code-draft-provider-result/v1",
  "title": "CodeDraftProviderResult",
  "type": "object",
  "required": ["contract", "provider", "requestDigest", "drafts", "resultDigest"],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "e2e-test/code-draft-provider-result/v1"
    },
    "provider": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "drafts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "file",
          "title",
          "source",
          "locatorApproach",
          "waitStrategy",
          "retryPolicy"
        ],
        "additionalProperties": false,
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1, "maxLength": 524288 },
          "locatorApproach": { "enum": ["role", "test-id"] },
          "waitStrategy": {
            "type": "object",
            "required": ["kind", "timeoutMs"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["poll", "event", "state"] },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120000
              }
            }
          },
          "retryPolicy": {
            "type": "object",
            "required": ["max"],
            "additionalProperties": false,
            "properties": {
              "max": { "const": 0 }
            }
          }
        }
      }
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
