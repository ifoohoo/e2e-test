{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "e2e-test/code-review-result/v1",
  "title": "CodeReviewResult",
  "type": "object",
  "required": [
    "contract",
    "reviewId",
    "planDigest",
    "requestDigest",
    "providerResultDigest",
    "repairRound",
    "maxRepairRounds",
    "status",
    "findings",
    "reviewDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "e2e-test/code-review-result/v1" },
    "reviewId": { "type": "string", "minLength": 1 },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "providerResultDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "repairRound": { "type": "integer", "minimum": 0 },
    "maxRepairRounds": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["PASS", "NEEDS_REPAIR", "BLOCKED"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "findingId",
          "caseId",
          "code",
          "severity",
          "repairOwner",
          "message",
          "evidenceDigest"
        ],
        "additionalProperties": false,
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "caseId": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "severity": { "enum": ["high", "medium", "low"] },
          "repairOwner": { "enum": ["test", "product", "environment"] },
          "message": { "type": "string", "minLength": 1 },
          "evidenceDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "reviewDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
