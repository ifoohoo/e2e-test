{
  "systems": [
    "catalog-api",
    "hold-service",
    "transfer-service",
    "circulation-service",
    "notification-service"
  ],
  "runnerInventory": {
    "playwright": {
      "active": true,
      "include": [
        "tests/e2e/**/*.spec.ts"
      ],
      "files": [
        "tests/e2e/holds/reserve-hold.spec.ts",
        "tests/e2e/holds/waitlist-advance.spec.ts",
        "tests/e2e/holds/overdue-release.spec.ts",
        "tests/e2e/holds/transfer-loss.spec.ts"
      ],
      "ignored": false
    }
  },
  "dataPolicy": {
    "identity": "unique-library-card",
    "isolation": "reservation-id partition"
  },
  "evidence": {
    "required": [
      "trace",
      "service-event-log"
    ],
    "freshness": "current"
  }
}
